PROJECT_NAME="E-Commerce API"
API_V1_STR="/api/v1"
ENVIRONMENT="testing"

# Database Connection (Async MySQL)
# Using SQLite for tests, but standard connection URL is required by config schema.
DATABASE_URL="sqlite+aiosqlite:///./test.db"

# Redis Connection
REDIS_URL="redis://localhost:6379/0"

# JWT Security
SECRET_KEY="super_secret_testing_key_do_not_use_in_prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Default Admin Credentials
FIRST_SUPERUSER_EMAIL="admin@example.com"
FIRST_SUPERUSER_PASSWORD="adminpassword123"

# Checkout
CHECKOUT_DELIVERY_FEE=5.00

# Mail notification setup
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_EMAIL="test@example.com"
SMTP_PASSWORD="test_password"

# Stripe payment gateway
DEFAULT_PAYMENT_GATEWAY="stripe"
DEFAULT_CURRENCY="usd"
STRIPE_API_KEY="sk_test_dummy_key"
STRIPE_WEBHOOK_SECRET="whsec_dummy_secret"
